# Credit Workflow Test Environment Configuration
# Copy this file to .env and update values as needed

# API Base URL
TEST_API_URL=https://credit.gavinslater.co.uk

# Default password for all test users (update with actual password)
TEST_PASSWORD=password123

# Test User Credentials
# Use actual usernames from your deployed system

# Relationship Manager (john.smith or sarah.jones)
TEST_RM_USER=john.smith
TEST_RM_PASSWORD=password123

# Credit Analyst (david.green)
TEST_CA_USER=david.green
TEST_CA_PASSWORD=password123

# Business Sponsor (mike.brown or lisa.white)
TEST_BS_USER=mike.brown
TEST_BS_PASSWORD=password123

# Legal Reviewer (david.guthrie)
TEST_LR_USER=david.guthrie
TEST_LR_PASSWORD=password123

# Credit Approver (david.green has approval authority)
TEST_APPROVER_USER=david.green
TEST_APPROVER_PASSWORD=password123
